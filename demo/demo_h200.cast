[162.3252, "o", "\r\n\u001b[1m   arm            TPOT p50   tok/s   vs KIVI-Tri  vs KIVI-CUDA  vs bf16*  TTFT    peak   facts\u001b[0m\r\n   HF-eager\r\n     KIVI            23.5 ms   42.6    1.12x        1.00x       0.52x    0.54 s   15.4 GB  3/3\r\n"]
[162.3253, "o", "     KIVI Triton     26.3 ms   38.0    1.00x        0.89x       0.47x    0.53 s   15.3 GB  3/3\r\n     Kitty           14.7 ms   67.8    1.78x        1.59x       0.84x    0.53 s   15.4 GB  3/3\r\n     bf16            12.3 ms   81.1    2.13x        1.91x       1.00x    0.27 s   15.7 GB  3/3\r\n     OMMX            18.0 ms   55.6    1.46x        1.31x       0.69x    0.40 s   15.5 GB  3/3\r\n   vLLM\r\n     vLLM bf16        5.6 ms  177.1    4.65x        4.16x       1.00x    0.12 s      -     3/3\r\n     TurboQuant       9.3 ms  108.0    2.84x        2.54x       0.61x    0.12 s      -     3/3\r\n     OMMX             8.0 ms  124.9    3.28x        2.94x       0.71x    0.42 s      -     3/3\r\n   vs KIVI-Tri = KIVI's Triton kernel, like-for-like with OMMX's Triton kernel; KIVI-CUDA = its CUDA kernel.\r\n   * vs the bf16 arm of the same framework. One request each; README numbers come from the benches.\r\n"]
